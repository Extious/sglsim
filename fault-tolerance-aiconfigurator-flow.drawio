                <mxCell id="p2_e4" value="latency query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" parent="1" source="p2_runner" target="p2_predictor" edge="1">
