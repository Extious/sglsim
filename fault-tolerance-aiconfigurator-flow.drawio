                </mxCell>
                <mxCell id="p3_queues" value="Scheduler queues&lt;br&gt;waiting_queue / retry_queue / running_batch / chunked_req&lt;br&gt;failed flag per dp_rank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="320" width="400" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p3_batch" value="get_next_batch_to_run() 顺序&lt;br&gt;1 running decode&lt;br&gt;2 chunked_req&lt;br&gt;3 retry_queue&lt;br&gt;4 waiting_queue + SchedulePolicy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="470" width="400" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p3_forward" value="ScheduleBatch EXTEND / DECODE&lt;br&gt;SimulatedModelRunner.forward()&lt;br&gt;process_batch_result() 追加 token 并 split running batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="650" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3_done" value="completed_reqs&lt;br&gt;或未完成请求继续 decode&lt;br&gt;retry_queue 可与 waiting_queue 同优先级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="820" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3_note" value="说明：这条 manager.Scheduler 路径是 upstream parity tests 覆盖的 native 兼容层；当前 HTTP RuntimeService 尚未把它作为默认 serving scheduler 接入。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="955" width="400" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p3_pool" value="ReqToTokenPool + TokenToKVPoolAllocator&lt;br&gt;alloc_for_extend / alloc_for_decode&lt;br&gt;release_kv_cache 统计 committed / overallocated freed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="170" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3_radix" value="RadixCache&lt;br&gt;insert / match_prefix / evict&lt;br&gt;lock_ref、last_access_time、hit_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="330" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3_hicache" value="HiRadixCache + HiCacheController&lt;br&gt;host backup: HostTokenPool&lt;br&gt;backup_finished_prefix() / host_hit_length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="480" width="400" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="p3_remote" value="RemoteBackupStorage / RemoteBackupStore&lt;br&gt;start_request / put_tokens / match_prefix_from&lt;br&gt;generation lease 防止旧写覆盖新请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="640" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3_details" value="cache detail helpers&lt;br&gt;apply_cache_source_breakdown()&lt;br&gt;build_cached_tokens_details()&lt;br&gt;device / host / storage / storage_query / reused_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="805" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p3_cache_out" value="online cache_hits.csv 字段映射&lt;br&gt;l1_match=device, l2_match=host&lt;br&gt;remote_match=storage_query, remote_prefetch=storage&lt;br&gt;failover columns 来自 usage.failover / sglext.failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="960" width="400" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p3_api" value="POST /simulate_gpu_failure&lt;br&gt;dp_rank / pp_rank / tp_rank / method&lt;br&gt;HTTP 层记录 failed_ranks 和 failover_events.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="170" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3_handle" value="Scheduler.handle_simulate_gpu_failure()&lt;br&gt;命中 dp_rank 时 failed=True&lt;br&gt;收集 running / waiting / retry / chunked snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="330" width="400" height="102" as="geometry"/>
                </mxCell>
                <mxCell id="p3_clear" value="_clear_failed_rank_state()&lt;br&gt;清空 failed rank 的队列和 running batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="490" width="400" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="p3_retry" value="_dispatch_retry(snapshot, healthy schedulers)&lt;br&gt;_retry_req_from_snapshot()&lt;br&gt;设置 is_failover_retried、failover_prefix_ids、pre_failover_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="630" width="400" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p3_recover" value="POST /simulate_gpu_recovery&lt;br&gt;HTTP failed_ranks discard&lt;br&gt;Scheduler.handle_simulate_gpu_recovery() 设置 failed=False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="805" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fail_meta" value="build_failover_details(req)&lt;br&gt;usage.failover / sglext.failover&lt;br&gt;pre_failover_output_tokens、pre_failover_backed_up_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="960" width="400" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p3_req" target="p3_queues" edge="1">
