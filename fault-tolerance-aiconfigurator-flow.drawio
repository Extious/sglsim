    <diagram id="http-cpu-runtime" name="2. HTTP CPU Runtime">
        <mxGraphModel dx="1086" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2_title" value="HTTP 请求路径：OpenAI 接口进入 RuntimeService，CPU model runner 逐 token 模拟" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
