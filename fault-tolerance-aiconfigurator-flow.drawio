                <mxCell id="p2_predict_lane" value="Prediction / timing" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#f8f9fa;strokeColor=#666666;fontStyle=1;fontSize=15;startSize=34;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="110" width="400" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="p2_req" value="POST /v1/completions&lt;br&gt;POST /v1/chat/completions&lt;br&gt;POST /generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="130" y="170" width="300" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p2_normalize" value="build_completion_input() 或 render_chat_prompt()&lt;br&gt;TokenizerManager 生成 RequestInput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="130" y="310" width="300" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p2_submit" value="RuntimeService.submit(req)&lt;br&gt;while output_len &lt; max_new_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="310" width="300" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p2_runner" value="SimulatedModelRunner.forward([req])&lt;br&gt;第一次：prefill extend_length=input_len&lt;br&gt;后续：decode extend_length=1, past_kv=input+generated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="460" width="300" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p2_tokens" value="生成确定性 token ids&lt;br&gt;output_token_ids=[1,2,...]&lt;br&gt;finished_reason=length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="630" width="300" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p2_meta" value="RequestState&lt;br&gt;output_text=tokN&lt;br&gt;default_cached_tokens_details(args)&lt;br&gt;default_failover_details()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="650" y="780" width="300" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p2_predictor" value="可选 predictor 注入&lt;br&gt;predict_requests([{extend_length,past_kv_length}])&lt;br&gt;若无 predictor，HTTP 默认不 sleep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="460" width="300" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p2_aiconf" value="AIConfigurator path&lt;br&gt;SimulatorConfigManager + ModelInfo + SchedulerConfig&lt;br&gt;AIConfiguratorTimePredictor.predict_requests()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="630" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_response" value="completion_response_from_state() / chat response&lt;br&gt;usage.prompt_tokens / completion_tokens / total_tokens&lt;br&gt;usage.cached_tokens_details + sglext mirror" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="130" y="780" width="300" height="94" as="geometry"/>
                </mxCell>
                <mxCell id="p2_note" value="当前接线状态：launch_server 会保存 --sim-config-path 的 active settings，但 create_app(args) 尚未自动根据 settings 构造 AIConfigurator predictor；HTTP RuntimeService 默认使用 SimulatedModelRunner(predictor=None)。测试里的 SimulatorApp/CPUScheduler 路径可显式传 predictor 并写 metrics.json。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="170" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p2_req" target="p2_normalize" edge="1">
