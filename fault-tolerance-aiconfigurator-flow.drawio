    <diagram id="legacy-offline" name="4. Legacy Offline Estimator">
        <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_title" value="Legacy offline FaultToleranceSimulator：快速估算路径，不是 benchmark 的权威实验路径" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="140" y="30" width="1320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cfg_lane" value="CLI / config" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#f8f9fa;strokeColor=#666666;fontStyle=1;fontSize=15;startSize=34;" parent="1" vertex="1">
                    <mxGeometry x="80" y="110" width="420" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sim_lane" value="Offline simulator" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#f8f9fa;strokeColor=#666666;fontStyle=1;fontSize=15;startSize=34;" parent="1" vertex="1">
                    <mxGeometry x="590" y="110" width="420" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="p4_out_lane" value="Outputs" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#f8f9fa;strokeColor=#666666;fontStyle=1;fontSize=15;startSize=34;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="110" width="420" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cli" value="sglsim-fault-sim&lt;br&gt;load_experiment_config()&lt;br&gt;server.json / client.json / failure.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="130" y="170" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_predict" value="latency predictor&lt;br&gt;ConstantLatencyPredictor 或 TaskPredictorAdapter&lt;br&gt;AIConfiguratorTimePredictor 只用于离线 task latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="130" y="330" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_workload" value="_build_workload()&lt;br&gt;fixed: num_requests&lt;br&gt;离线 estimator 仍可保留旧 workload 形状&lt;br&gt;online benchmark 当前只迁移 fixed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="170" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_plan" value="planned_jobs = _simulate_schedule(include_fault_effects=False)&lt;br&gt;先计算无故障完成顺序和 trigger time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="330" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_fault" value="_resolve_fault_trigger() + _resolve_recovery_time()&lt;br&gt;job / task / timeline&lt;br&gt;recover_after_task / recover_after_job / recovery_delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="480" width="320" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p4_resim" value="最多 8 轮重算带故障 schedule&lt;br&gt;STRATEGY_MODELS: baseline / host_backup / remote_backup&lt;br&gt;PageAllocator 估算 recovered pages / recomputed tokens / transfer_s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="650" width="320" height="114" as="geometry"/>
                </mxCell>
                <mxCell id="p4_events" value="_build_events()&lt;br&gt;fault_scheduled / simulate_gpu_failure_api / fault_injected&lt;br&gt;runtime_failover_reaction / kv_pages_migrated / gpu_recovered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="170" width="320" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="p4_metrics" value="_build_metrics()&lt;br&gt;throughput、latency、queue wait&lt;br&gt;reuse / recompute / impacted jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="350" width="320" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p4_files" value="write_outputs()&lt;br&gt;metrics.json / events.jsonl&lt;br&gt;job_summary.csv / task_summary.csv / cache_hits.csv&lt;br&gt;internal_failover_metrics.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="520" width="320" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p4_note" value="定位：这个路径可以快速生成 benchmark-shaped 文件用于比较，但它不运行真实 HTTP 请求、不经过 live scheduler/cache/failover state，因此不应作为 fault-tolerance 实验最终结论。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="710" width="320" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_cli" target="p4_predict" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e2" value="config + predictor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" parent="1" source="p4_predict" target="p4_workload" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_workload" target="p4_plan" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_plan" target="p4_fault" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_fault" target="p4_resim" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_resim" target="p4_events" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="800" y="820"/>
                            <mxPoint x="1310" y="820"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_events" target="p4_metrics" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="p4_metrics" target="p4_files" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
