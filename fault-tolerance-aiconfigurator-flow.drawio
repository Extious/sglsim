                <mxCell id="p2_e2" value="RequestInput" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" parent="1" source="p2_normalize" target="p2_submit" edge="1">
