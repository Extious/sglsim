<mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="1" shadow="0">
  <root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="title" value="Failure-time recovery: choose one valid path, then replay the suffix" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#183B56;" vertex="1" parent="1"><mxGeometry x="300" y="25" width="1000" height="45" as="geometry"/></mxCell>
    <mxCell id="failure" value="Owner rank fails" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCE6E4;strokeColor=#B54A43;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="190" height="100" as="geometry"/></mxCell>
    <mxCell id="lookup" value="Lookup deepest valid\ncommitted frontier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFB;strokeColor=#66529B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="230" height="100" as="geometry"/></mxCell>
    <mxCell id="gpu" value="L1 Backup path\nroute + queue + resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E8;strokeColor=#327E60;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="host" value="L2 Backup path\nroute + H2D + resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#B56F28;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="260" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="recompute" value="Recompute path\nroute + prefill suffix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2D638F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="choose" value="Choose minimum predicted\nworkflow loss path" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#59636F;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="230" width="260" height="160" as="geometry"/></mxCell>
    <mxCell id="replay" value="Restore selected prefix\nReplay q+1:z if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E8;strokeColor=#327E60;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1390" y="180" width="180" height="100" as="geometry"/></mxCell>
    <mxCell id="resume" value="Resume request\nand update WCT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E8;strokeColor=#327E60;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="360" width="180" height="100" as="geometry"/></mxCell>
    <mxCell id="note" value="Path costs are mutually exclusive alternatives. Restore, queue, replay and resume time are already included in the chosen path and are not charged again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#59636F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="650" width="900" height="75" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54A43;endArrow=block;" edge="1" source="failure" target="lookup" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="valid peer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#327E60;endArrow=block;" edge="1" source="lookup" target="gpu" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="valid host" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B56F28;endArrow=block;" edge="1" source="lookup" target="host" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="always feasible" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2D638F;endArrow=block;" edge="1" source="lookup" target="recompute" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#327E60;endArrow=block;" edge="1" source="gpu" target="choose" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B56F28;endArrow=block;" edge="1" source="host" target="choose" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2D638F;endArrow=block;" edge="1" source="recompute" target="choose" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#327E60;endArrow=block;" edge="1" source="choose" target="replay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
