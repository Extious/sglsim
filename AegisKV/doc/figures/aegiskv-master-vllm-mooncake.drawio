                <mxCell id="model_layer" value="PAPER MODEL · MathJax 公式与逐式中文解释" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#F1ECFF;swimlaneFillColor=#FCFBFF;strokeColor=#7E62BC;strokeWidth=1.8;fontSize=15;fontStyle=1;fontColor=#4C3381;fontFamily=Noto Sans CJK SC;" parent="1" vertex="1">
                    <mxGeometry x="2430" y="100" width="1840" height="1600" as="geometry"/>
                </mxCell>
                <mxCell id="model_alg1" value="A · Algorithm 1 — Causal Slack Tracker" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#E2F4E9;swimlaneFillColor=#FBFFFC;strokeColor=#3F9462;strokeWidth=1.8;fontSize=14;fontStyle=1;fontColor=#1F5C3B;fontFamily=Noto Sans CJK SC;" parent="model_layer" vertex="1">
                    <mxGeometry x="30" y="55" width="1780" height="275" as="geometry"/>
                </mxCell>
                <mxCell id="m1_inputs" value="输入：当前已揭示 DAG / progress 与 fenced hard residual-plan bounds；无 hard witness 时 fail closed，禁止读取 future trace" style="text;html=1;whiteSpace=wrap;align=left;spacingLeft=12;verticalAlign=middle;fontSize=12;fontColor=#2B5D41;fontFamily=Noto Sans CJK SC;" parent="model_alg1" vertex="1">
                    <mxGeometry x="20" y="42" width="1740" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="m1_slack" value="$$s_i^{B}=\left[L_{-i}-U_i\right]_+,\qquad D_i=t_0+s_i^{B}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#173F2A;fontFamily=Times New Roman;" parent="model_alg1" vertex="1">
                    <mxGeometry x="20" y="82" width="900" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="m1_slack_desc" value="L−i 是旁支完成的 causal lower bound，Ui 是该 branch 恢复后的 remaining-time upper bound。二者均为 hard witness 时得到 BOUNDED；缺 witness 时输出 UNKNOWN，而不是猜一个正 Slack。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#EFF9F3;strokeColor=#B7DCC5;fontSize=11;fontColor=#285B3E;fontFamily=Noto Sans CJK SC;" parent="model_alg1" vertex="1">
                    <mxGeometry x="940" y="82" width="820" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="m1_critical" value="$$H_i(p)=\left[p-s_i\right]_+$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#173F2A;fontFamily=Times New Roman;" parent="model_alg1" vertex="1">
                    <mxGeometry x="20" y="140" width="900" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m1_critical_desc" value="恢复停顿 p 只有跨过 absolute deadline 才产生 workflow risk。使用 sB 时 H 是 deadline-risk upper envelope；两个 envelope 的差不是 realized WCT benefit 的下界，真实收益由 paired faults 测。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#EFF9F3;strokeColor=#B7DCC5;fontSize=11;fontColor=#285B3E;fontFamily=Noto Sans CJK SC;" parent="model_alg1" vertex="1">
                    <mxGeometry x="940" y="140" width="820" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m1_contract" value="版本化 ticket：workflow/request · observed_at · deadline_at · BOUNDED/UNKNOWN · hard witness · source domain · fixed target · route version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EFF9F3;strokeColor=#8AC2A0;fontSize=12;fontStyle=1;fontColor=#285B3E;fontFamily=Noto Sans CJK SC;" parent="model_alg1" vertex="1">
                    <mxGeometry x="20" y="208" width="1740" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="model_alg2" value="B · Algorithm 2 — Slack-Deadline KV Manager（在线策略）" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#E5EEFF;swimlaneFillColor=#FCFDFF;strokeColor=#557FC2;strokeWidth=1.8;fontSize=14;fontStyle=1;fontColor=#294E82;fontFamily=Noto Sans CJK SC;" parent="model_layer" vertex="1">
                    <mxGeometry x="30" y="345" width="1780" height="825" as="geometry"/>
                </mxCell>
                <mxCell id="m2_scope" value="动作：Retain quota-backed tier lease · Extend next continuous chunk · Accelerate SSD→DRAM / Store→peer HBM · Release；普通 cache policy 仍管理一般 reuse/offload" style="text;html=1;whiteSpace=wrap;align=left;spacingLeft=12;verticalAlign=middle;fontSize=12;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="42" width="1740" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="m2_objective" value="$$R_d(S)=\left(\max_j[\,C_j(S)-D_j\,]^+,\;\sum_w H_{d,w}(S)\right)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#1F416F;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="88" width="900" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="m2_objective_desc" value="每个 source-domain fail-now 情景只在 Router 固定的 target 上按 EDF 排恢复 jobs。第一维是最坏 deadline miss；第二维用 workflow frontier 的 max 聚合后求和，只作固定 dispatch 下的 tie-break。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="88" width="820" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c1" value="$$R(S)=\left(\max_d R_d^{\max}(S),\;\sum_d R_d^{\sum}(S)\right)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="165" width="900" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c1_desc" value="无可调 tenant/domain 风险权重，也不估计罕见 failure probability：先降低所有声明单故障情景中的最坏 deadline miss，再以总暴露打破并列。租户隔离由独立 quota/risk-class pool 提供。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="165" width="820" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c2" value="$$\operatorname{Gain}(a\mid S)=R(S;\tau_a)-R(S\oplus a;\tau_a)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="224" width="900" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c2_desc" value="S 只含已 group-commit 的真实状态。S⊕a 是 action 在保守 completion horizon τa 完整提交后的 prospective state；absolute deadline 在复制期间继续消耗，commit 前发生故障时 action value 必为 0。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="224" width="820" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c3" value="$$\rho(a)=\max_r\frac{\operatorname{Demand}_r(a)}{\operatorname{Budget}_r}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="291" width="900" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c3_desc" value="ρ 只是无量纲 dominant resource share，用来归一化 gain density；bytes/capacity、window traffic/window allowance、byte-seconds/pin budget、slots/slot cap 分别同量纲比较，不继承 DRF fairness 结论。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="291" width="820" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c4" value="$$\operatorname{cover}(v\mid\delta)=\sum_r\frac{\min\{\operatorname{Release}_r(v),\delta_r\}}{\operatorname{Budget}_r}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="346" width="900" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c4_desc" value="预算已满时按 Loss(v|S)/cover 贪心找 victims，每次重新计算 deficit；资源实际释放后才评估完整 NetGain=R(S)−R(S−V+a)。无通用 approximation ratio，小实例用 exact/MILP oracle 报 gap。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="346" width="820" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c5" value="$$\text{reserve}\rightarrow\text{copy}\rightarrow\text{validate}\rightarrow\text{group commit}\rightarrow\text{FreezeAndPin}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="407" width="900" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c5_desc" value="只有 sealed immutable chunk 的全部 required ranks 对同一 logical version ACK 后才 group-commit；故障时再原子 pin 当前连续 groups。reservation、partial write、late ACK、未 pin copy 均不能进入 recovery-visible set。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="407" width="820" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c6" value="$$j^*=\arg\min_{j\in\operatorname{ready}}\left(D_j,\;p_j^{\rm rem},\;\operatorname{id}_j\right)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="468" width="900" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="m2_c6_desc" value="实际故障只保留 realized domain 的 target-local EDF。理想单 lane 可证明最小 Lmax；严格单 outstanding chunk 且 terminal time≤Bg 时得到一个 quantum 的 additive bound，否则标记 UNISOLATED。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="468" width="820" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="m2_regret" value="$$\text{exact protection selection is NP-hard (0--1 knapsack reduction)}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="539" width="900" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_regret_desc" value="NP-hardness 是理论结论，不需要实验。Offline exact/MILP replay 只量化 greedy 的实际 gap、myopic regret 与 decision p99；它不是在线控制路径，也不使用来证明 hardness。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="539" width="820" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_guard" value="$$U_{\rm primary}+U_{\rm peer}+\operatorname{Reserve}\le C_{\rm KV}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontColor=#294E82;fontFamily=Times New Roman;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="600" width="900" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_guard_desc" value="每次 allocator mutation 原子维护容量账本；primary growth 先回收 peer，Reserve 覆盖 bounded reclaim 期间增长与不可回收 pins。该不变量靠归纳证明并由 property tests 检查，不靠吞吐实验证明。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#B6C9E8;fontSize=11;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="940" y="600" width="820" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="m2_execution" value="实现映射：Router 固定 target/output fence 与 continuation record · Controller 计算 action 与 EDF priority · Store Master 管 key/quota-backed tier lease/node state · Workers 执行 HBM page、transfer、group commit、FreezeAndPin 与 adoption" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#8AA9D8;fontSize=12;fontStyle=1;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="model_alg2" vertex="1">
                    <mxGeometry x="20" y="675" width="1740" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="model_alg3" value="C · Algorithm 3 — TCP-Style AIMD：每个 DP 一个弹性 HBM admission envelope α" style="swimlane;startSize=34;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#EEE8FF;swimlaneFillColor=#FDFCFF;strokeColor=#7E62BC;strokeWidth=1.8;fontSize=14;fontStyle=1;fontColor=#503884;fontFamily=Noto Sans CJK SC;" parent="model_layer" vertex="1">
                    <mxGeometry x="30" y="1185" width="1780" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="m3_scope" value="窗口 K 的 Serving Engine 反馈 Fᴷ：各 PP stage 的 free blocks / headroom · allocation stall · TPOT/latency slowdown · queue pressure · copy backlog" style="text;html=1;whiteSpace=wrap;align=left;spacingLeft=12;verticalAlign=middle;fontSize=12;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="42" width="1740" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="m3_budget" value="$$T_{di}^{K}=\left\lfloor\alpha_d^K C_{di}^{\rm HBM}\right\rfloor,\qquad \alpha_d^K\le\min_i\alpha_{di,\rm headroom}^{K}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#503884;fontFamily=Times New Roman;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="80" width="900" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m3_budget_desc" value="T 是准入目标水位，不是物理预留区。一个 DP 的 α 同时发布给 PP0–PP3，但必须服从最紧张 stage 的安全 headroom；Serving Engine 可以继续使用未被 recovery 对象占用的 HBM，避免固定 carve-out 破坏弹性。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#C6B6E3;fontSize=11;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="940" y="80" width="820" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m3_value" value="$$\operatorname{safe}_d^K=\bigwedge_i\left(H_{di}^K\ge H_{\min}\ \wedge\ \neg stall_{di}^K\ \wedge\ TPOT_{di}^K\le SLO\ \wedge\ Q_{di}^K\le Q_{\max}\right)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontColor=#503884;fontFamily=Times New Roman;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="135" width="900" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m3_value_desc" value="safe 是可直接观测的系统谓词：所有 PP stages 都有足够 headroom，且无分配 stall、TPOT/SLO 超限或队列压力。只有连续 N 个 safe 窗口才允许加性增加；任一 stage 报警即进入乘性减小，天然由瓶颈 stage 控制。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#C6B6E3;fontSize=11;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="940" y="135" width="820" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m3_update" value="$$\alpha_d^{K+1}=\begin{cases}\min(\alpha_d^K+\Delta_d,\alpha_{d,\max}),&amp;N\text{ consecutive safe windows}\\ \max(\gamma_d\alpha_d^K,0),&amp;\exists i:\operatorname{pressure}_{di}^K\\ \alpha_d^K,&amp;\text{otherwise}\end{cases}\quad 0&lt;\gamma_d&lt;1$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#503884;fontFamily=Times New Roman;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="190" width="900" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="m3_update_desc" value="TCP-style 因果反馈：稳定窗口中缓慢增加 residual peer-HBM / copy-rate budget；任一 stage 出现 stall、headroom 或 SLO 压力时快速收缩。控制稳定性与响应速度必须由 step-response measurement 回答。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#C6B6E3;fontSize=11;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="940" y="190" width="820" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="m3_guard" value="$$O_{di}^{K}&gt;T_{di}^{K+1}\ \Longrightarrow\ \text{block new H-admission + bounded clean-first demotion}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontColor=#503884;fontFamily=Times New Roman;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="259" width="900" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m3_guard_desc" value="α 下降先停止新 peer-HBM admission，再按 Algorithm 2 的 risk loss 选择可释放 shadow；Store 已完整副本可直接支撑 demotion，in-flight reservation 必须等 terminal ACK 后才释放预算。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#C6B6E3;fontSize=11;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="940" y="259" width="820" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="m3_flow" value="闭环：engine telemetry Fᴷ → AIMD 更新 residual budget → Algorithm 2 准入 / release → allocator ledger commit → 下一窗口观测" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#A792D0;fontSize=12;fontStyle=1;fontColor=#503884;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="315" width="1740" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="m3_store_note" value="职责分离：Algorithm 2 决定 KV action 与 recovery order；Algorithm 3 只调 residual resource envelope；Workers / Store 执行数据面。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#765716;fontFamily=Noto Sans CJK SC;" parent="model_alg3" vertex="1">
                    <mxGeometry x="20" y="350" width="1740" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="model_legend" value="证据边界：causality / NP-hardness / EDF / capacity / identity necessity 用理论证明；commit / pin / adoption / continuation 用 correctness tests；机会、成本、控制响应与 realized WCT/SLO 才需要性能实验。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#C9D1DB;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#5E6C84;fontFamily=Noto Sans CJK SC;" parent="1" vertex="1">
                    <mxGeometry x="2470" y="1720" width="1760" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="e_app_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#3F9462;strokeWidth=2;endArrow=classic;endFill=1;" parent="1" source="app_handler" target="alg1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_app_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#3F9462;strokeWidth=2;endArrow=classic;endFill=1;" parent="1" source="alg1" target="router" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_app_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#4C8DCA;strokeWidth=2;endArrow=classic;endFill=1;" parent="1" source="router" target="request_contract" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_alg1_formal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#3F9462;strokeWidth=2;dashed=1;endArrow=classic;endFill=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" parent="1" source="alg1" target="model_alg1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="698" y="95"/>
