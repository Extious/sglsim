<mxfile host="65bd71144e">
    <diagram id="aegiskv-paper-story" name="AegisKV Paper Story">
        <mxGraphModel dx="1311" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1450" background="#F7F9FC" math="1" shadow="0">
            <root>
                <mxCell id="story_0"/>
                <mxCell id="story_1" parent="story_0"/>
                <mxCell id="story_title" value="AegisKV: An Agent-Aware LLM Inference Fault-Tolerance Architecture" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontStyle=1;fontColor=#172B4D;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
                    <mxGeometry x="180" y="18" width="2040" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="story_subtitle" value="Causal deadlines → Slack-Deadline KV actions → group-committed prefix → TCP-style AIMD resource envelope" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#5E6C84;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
                    <mxGeometry x="250" y="65" width="1900" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="story_scope" value="Scope: fail-stop worker/group failure · Router-fixed compatible recovery target · causal decisions from currently revealed workflow state" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF7E6;strokeColor=#D6A737;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#765716;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
                    <mxGeometry x="90" y="108" width="2220" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="story_challenges" value="1 · WHY NOW? NEW FAILURE CHALLENGES IN THE MULTI-AGENT ERA" style="swimlane;startSize=42;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#FDE8E7;swimlaneFillColor=#FFFCFC;strokeColor=#D95C59;strokeWidth=1.8;fontSize=15;fontStyle=1;fontColor=#8F2D2A;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
                    <mxGeometry x="90" y="175" width="2220" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="story_challenge_long" value="1 · Long context amplifies retry cost&#xa;&#xa;Prompts accumulate Thinking, tool results, and prior turns.&#xa;&#xa;A GPU failure can force a long Prefill/Decode tail to be recomputed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF4F3;strokeColor=#D95C59;strokeWidth=1.8;fontSize=13;fontStyle=1;fontColor=#7D2A27;fontFamily=Noto Sans CJK SC;" parent="story_challenges" vertex="1">
                    <mxGeometry x="35" y="66" width="660" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="story_challenge_dag" value="2 · Workflow requests are not equally urgent&#xa;&#xa;Multi-step agents form a dependency DAG with a critical path.&#xa;&#xa;The same retry delay has different workflow-completion impact." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF4F3;strokeColor=#D95C59;strokeWidth=1.8;fontSize=13;fontStyle=1;fontColor=#7D2A27;fontFamily=Noto Sans CJK SC;" parent="story_challenges" vertex="1">
                    <mxGeometry x="780" y="66" width="660" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="story_challenge_gap" value="3 · Cache presence is not recoverable state&#xa;&#xa;Tiered KV caches already retain and offload data.&#xa;&#xa;Recovery additionally needs compatible identity, group commit, failure-time pinning, allocator adoption, and a durable continuation record." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF4F3;strokeColor=#D95C59;strokeWidth=1.8;fontSize=13;fontStyle=1;fontColor=#7D2A27;fontFamily=Noto Sans CJK SC;" parent="story_challenges" vertex="1">
                    <mxGeometry x="1525" y="66" width="660" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="story_challenge_consequence" value="Consequence: failure recovery must understand both accumulated KV value and each request&#39;s remaining workflow slack." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDE8E7;strokeColor=#E49A98;strokeWidth=1.2;fontSize=12;fontStyle=1;fontColor=#8F2D2A;fontFamily=Noto Sans CJK SC;" parent="story_challenges" vertex="1">
                    <mxGeometry x="260" y="262" width="1700" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="story_design_goal" value="Design principle · Spend a bounded protection budget where recovery crosses a workflow deadline&#xa;$$\min_{\rm lex}\;(\text{worst deadline miss},\;\text{total workflow overrun})\qquad\text{s.t. resource and serving floors}$$" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF7EF;strokeColor=#3F9462;strokeWidth=2.5;fontSize=16;fontStyle=1;fontColor=#1F5C3B;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
                    <mxGeometry x="410" y="545" width="1580" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="story_solution" value="2 · AEGISKV: A THREE-ALGORITHM CAUSAL CONTROL LOOP" style="swimlane;startSize=42;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#EAF1FB;swimlaneFillColor=#FBFCFF;strokeColor=#5B8CCB;strokeWidth=1.8;fontSize=15;fontStyle=1;fontColor=#244E7A;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
                    <mxGeometry x="90" y="710" width="2220" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg1" value="Algorithm 1 · Causal Slack Tracker" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#DFF3E7;swimlaneFillColor=#FBFFFC;strokeColor=#3F9462;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#1F5C3B;fontFamily=Noto Sans CJK SC;" parent="story_solution" vertex="1">
                    <mxGeometry x="30" y="68" width="610" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg1_input" value="Input&#xa;revealed workflow DAG · progress · fenced hard residual-plan bounds" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EFF9F3;strokeColor=#A7D3B8;fontSize=12;fontColor=#285B3E;fontFamily=Noto Sans CJK SC;" parent="story_alg1" vertex="1">
                    <mxGeometry x="25" y="58" width="560" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg1_formula" value="$$s_i^{B}=\left[L_{-i}-U_i\right]_+,\qquad D_i=t_0+s_i^{B}$$" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#57A773;strokeWidth=1.5;fontSize=16;fontStyle=1;fontColor=#173F2A;fontFamily=Times New Roman;" parent="story_alg1" vertex="1">
                    <mxGeometry x="25" y="140" width="560" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg1_output" value="Output: BOUNDED / UNKNOWN&#xa;an absolute recovery deadline, never a resettable TTL&#xa;UNKNOWN falls back without guessing the future" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EFF9F3;strokeColor=#A7D3B8;fontSize=12;fontStyle=1;fontColor=#285B3E;fontFamily=Noto Sans CJK SC;" parent="story_alg1" vertex="1">
                    <mxGeometry x="25" y="214" width="560" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg2" value="Algorithm 2 · Slack-Deadline KV Manager" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#E5EEFF;swimlaneFillColor=#FCFDFF;strokeColor=#557FC2;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#294E82;fontFamily=Noto Sans CJK SC;" parent="story_solution" vertex="1">
                    <mxGeometry x="685" y="68" width="850" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg2_rule" value="Retain · Extend · Accelerate · Release. Score only post-commit risk reduction, use fixed-target EDF, and admit actions under explicit multi-resource caps." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="story_alg2" vertex="1">
                    <mxGeometry x="25" y="47" width="800" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="story_tier_hbm" value="Peer HBM · α&#xa;&#xa;Hot redundant recovery cache&#xa;Engine owns pages&#xa;AIMD sets target envelope" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF7EF;strokeColor=#3F9462;strokeWidth=1.7;fontSize=11;fontStyle=1;fontColor=#1F5C3B;fontFamily=Noto Sans CJK SC;" parent="story_alg2" vertex="1">
                    <mxGeometry x="20" y="105" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="story_tier_dram" value="Store DRAM&#xa;&#xa;Recovery object + offload tier&#xa;Quota-backed tier lease&#xa;Group-committed chunks" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.7;fontSize=11;fontStyle=1;fontColor=#765716;fontFamily=Noto Sans CJK SC;" parent="story_alg2" vertex="1">
                    <mxGeometry x="225" y="105" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="story_tier_ssd" value="Store SSD&#xa;&#xa;Large cold recovery tier&#xa;Higher restore latency&#xa;Immutable object + lease" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FCE8D5;strokeColor=#D79B00;strokeWidth=1.7;fontSize=11;fontStyle=1;fontColor=#7A4B00;fontFamily=Noto Sans CJK SC;" parent="story_alg2" vertex="1">
                    <mxGeometry x="430" y="105" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="story_tier_recompute" value="Recompute · N&#xa;&#xa;Logical fallback, not a tier&#xa;No residency rent&#xa;Largest recovery delay" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=1.7;fontSize=11;fontStyle=1;fontColor=#4A4A4A;fontFamily=Noto Sans CJK SC;" parent="story_alg2" vertex="1">
                    <mxGeometry x="635" y="105" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg2_output" value="Output: quota-backed tier leases / peer shadows · all-rank group commit · failure-time FreezeAndPin before adoption" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F2F6FF;strokeColor=#8AA9D8;fontSize=12;fontStyle=1;fontColor=#315A89;fontFamily=Noto Sans CJK SC;" parent="story_alg2" vertex="1">
                    <mxGeometry x="20" y="250" width="805" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg3" value="Algorithm 3 · TCP-Style AIMD HBM Envelope" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#EEE8FF;swimlaneFillColor=#FDFCFF;strokeColor=#7E62BC;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#503884;fontFamily=Noto Sans CJK SC;" parent="story_solution" vertex="1">
                    <mxGeometry x="1580" y="68" width="610" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg3_feedback" value="Serving-engine feedback&#xa;min PP-stage HBM headroom · allocation stalls&#xa;TPOT / latency slowdown · queue pressure" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#C6B6E3;fontSize=12;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="story_alg3" vertex="1">
                    <mxGeometry x="25" y="58" width="560" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg3_formula" value="$$\begin{aligned}\text{safe }N:&amp;\ \alpha_d^{K+1}=\min(\alpha_d^K+\Delta,\alpha_{\max})\\ \text{pressure}:&amp;\ \alpha_d^{K+1}=\max(\gamma\alpha_d^K,0)\end{aligned}$$" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#7E62BC;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#503884;fontFamily=Times New Roman;" parent="story_alg3" vertex="1">
                    <mxGeometry x="25" y="154" width="560" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="story_alg3_output" value="One logical α target per DP; no fixed HBM arena&#xa;decrease changes the watermark, then clean-first demotion drains gradually&#xa;all PP stages obey the minimum safe headroom" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F5F1FF;strokeColor=#C6B6E3;fontSize=12;fontStyle=1;fontColor=#5B438C;fontFamily=Noto Sans CJK SC;" parent="story_alg3" vertex="1">
                    <mxGeometry x="25" y="238" width="560" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="story_e_alg1_alg2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#557FC2;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="story_solution" source="story_alg1" target="story_alg2" edge="1">
