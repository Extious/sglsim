                </mxCell>
                <mxCell id="master_registry" value="Committed-Group Registry&#xa;&#xa;content version ≠ issuer epoch&#xa;rank-local checksum + allocator generation&#xa;continuous prefix + pin/read-lease state" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6D5DA8;strokeWidth=1.8;fontSize=13;fontStyle=1;fontColor=#40306D;fontFamily=Noto Sans CJK SC;" parent="master" vertex="1">
