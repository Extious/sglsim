                <mxCell id="story_outcomes" value="3 · SYSTEM OUTCOME" style="swimlane;startSize=36;horizontal=1;rounded=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;fillColor=#DFF3E7;swimlaneFillColor=#FBFFFC;strokeColor=#3F9462;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#1F5C3B;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
