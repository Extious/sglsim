                <mxCell id="story_outcome_1" value="Critical-path aware&#xa;Slack directs protection to requests whose retry delay changes workflow WCT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF7EF;strokeColor=#57A773;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#244B36;fontFamily=Noto Sans CJK SC;" parent="story_outcomes" vertex="1">
                    <mxGeometry x="30" y="55" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="story_outcome_2" value="Reduced exposed retry work when checkpoints survive&#xa;Restore the committed prefix, then recompute only its uncommitted suffix" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF7EF;strokeColor=#57A773;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#244B36;fontFamily=Noto Sans CJK SC;" parent="story_outcomes" vertex="1">
                    <mxGeometry x="580" y="55" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="story_outcome_3" value="One online KV policy&#xa;Deadline-risk reduction jointly changes Store tier lease, peer-HBM protection, and post-failure restore order" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF7EF;strokeColor=#57A773;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#244B36;fontFamily=Noto Sans CJK SC;" parent="story_outcomes" vertex="1">
                    <mxGeometry x="1130" y="55" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="story_outcome_4" value="Healthy-workflow guard&#xa;Normal-path slowdown remains an explicit hard constraint" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF7EF;strokeColor=#57A773;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#244B36;fontFamily=Noto Sans CJK SC;" parent="story_outcomes" vertex="1">
                    <mxGeometry x="1680" y="55" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="story_reviewer_note" value="Evidence boundary: proofs establish causal/scheduling/capacity properties; race and hard-kill tests establish implementation conformance; only opportunity, cost, and realized WCT/SLO benefit require performance measurements." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFDF7;strokeColor=#D6B656;strokeWidth=1.2;fontSize=11;fontColor=#765716;fontFamily=Noto Sans CJK SC;" parent="story_1" vertex="1">
