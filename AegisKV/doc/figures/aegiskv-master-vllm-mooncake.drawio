                <mxCell id="subtitle" value="Causal deadlines → robust KV action selection → group commit / FreezeAndPin → fixed-target EDF → TCP-style AIMD" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#5E6C84;fontFamily=Noto Sans CJK SC;" parent="1" vertex="1">
