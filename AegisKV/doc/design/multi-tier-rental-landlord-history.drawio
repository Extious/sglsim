        <mxCell id="score" value="&lt;font color=&quot;#557487&quot; style=&quot;font-size:16px&quot;&gt;2 · SCORE&lt;/font&gt;&lt;br&gt;&lt;b&gt;A = Gain(x, t)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Θ = L&lt;sub&gt;r&lt;/sub&gt; + A / b&lt;sub&gt;c&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Slack-visible recovery gain&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E91A8;strokeWidth=2;fontSize=21;fontFamily=Noto Sans CJK SC;fontColor=#244B59;" vertex="1" parent="1">
