        <mxCell id="candidate" value="&lt;font color=&quot;#557487&quot; style=&quot;font-size:16px&quot;&gt;1 · INPUT&lt;/font&gt;&lt;br&gt;&lt;b&gt;Candidate x = (c, r)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Router 已固定目标&lt;br&gt;DRAM / Peer HBM&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E91A8;strokeWidth=2;fontSize=21;fontFamily=Noto Sans CJK SC;fontColor=#244B59;" vertex="1" parent="1">
