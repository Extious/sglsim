{
  "experiment_name": "ma-ft-gpu-backup-critical-a100-dp2",
  "model_path": "Qwen/Qwen3-8B",
  "host": "127.0.0.1",
  "port": 30000,
  "platform": {
    "accelerator": {
      "name": "a100_sxm",
      "hbm_capacity_gb": 80
    },
    "num_device_per_node": 8
  },
  "cache": {
    "page_size": 1,
    "enable_hierarchical_cache": false,
    "l3_capacity_pages": 0,
    "kv_capacity_scale_factor": 1.0
  },
  "predictor": {
    "name": "aiconfigurator",
    "database_mode": "SILICON",
    "prefill_scale_factor": 1.05,
    "decode_scale_factor": 0.90,
    "forward_scale": 1.0
  },
  "scheduler": {
    "tp_size": 1,
    "pp_size": 1,
    "dp_size": 2,
    "max_running_requests": null,
    "load_balance_method": "round_robin",
    "enable_routing_key_affinity": false,
    "decode_log_interval": 40,
    "backend_name": "sglang",
    "backend_version": "0.5.10",
    "mem_fraction_static": 0.836,
    "init_new_token_ratio": 0.65,
    "disable_overlap_schedule": false
  },
  "communication": {
    "mode": "alpha_beta"
  },
  "fault_tolerance": {
    "enabled": true,
    "strategy": "gpu_backup",
    "backup_policy": "critical_agents",
    "peer_backup_lag_tokens": 8,
    "backup_prefill_tokens": "all",
    "backup_decode": true,
    "trigger": {
      "enabled": true,
      "fault_dp_rank": 0,
      "inject_after_s": 30,
      "recover_after_s": 120
    }
  }
}
