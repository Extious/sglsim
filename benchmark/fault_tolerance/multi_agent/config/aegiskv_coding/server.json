{
  "name": "aegiskv-multi-agent-gpureplica-v2",
  "description": "Two-round multi-agent coding workflow with three-way GPUReplica backup comparison",
  "platform": "a100",
  "kv_backup": "gpu_backup",
  "server": {
    "dp_size": 2,
    "pp_size": 1,
    "tp_size": 1,
    "enable_hicache": false,
    "hicache_ratio": 0.0,
    "context_length": 200000
  },
  "aegiskv": {
    "enabled": true,
    "policy": "aegiskv",
    "backup_target": "GPUReplica",
    "peer_backup_lag_tokens": 8,
    "decode_epoch_tokens": 8,
    "critical_agents": ["O0", "S2", "S5"]
  }
}
